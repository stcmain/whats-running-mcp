{
  "name": "whats-running-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.stcmain/whats-running-mcp",
  "description": "MCP server that gives agents ground truth of what is ACTUALLY running on this machine — agent sessions, listening ports, daemons — read live from the OS, never from stale docs or memory.",
  "type": "module",
  "bin": {
    "whats-running-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "agents",
    "observability",
    "process-monitoring"
  ],
  "author": "Zachary Pampu <info@shifttheculture.media>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stcmain/whats-running-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
